# Application
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL
POSTGRES_DB=medtrace
POSTGRES_USER=medtrace
POSTGRES_PASSWORD=medtrace
DATABASE_URL=postgresql+asyncpg://medtrace:medtrace@postgres:5432/medtrace

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# AgentGuard observability API
AGENTGUARD_PUBLIC_KEY=
AGENTGUARD_SECRET_KEY=
AGENTGUARD_BASE_URL=http://localhost:3001
AGENTGUARD_PROMPT_NAME=AI Doctor
AGENTGUARD_PROMPT_CACHE_TTL_SECONDS=60
PROMPT_LABEL_A=production
PROMPT_LABEL_B=latest
EXPERIMENT_SPLIT=50

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=medical_knowledge

# Frontend
VITE_API_URL=
