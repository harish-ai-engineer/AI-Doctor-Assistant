# Application
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL
POSTGRES_DB=medtrace
POSTGRES_USER=medtrace
POSTGRES_PASSWORD=medtrace
DATABASE_URL=postgresql+asyncpg://medtrace:medtrace@postgres:5432/medtrace

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Langfuse Cloud (EU). Use https://us.cloud.langfuse.com for US.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_NAME=doctor-assistant
PROMPT_LABEL_A=production
PROMPT_LABEL_B=staging
EXPERIMENT_SPLIT=50

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=medical_knowledge

# Frontend
VITE_API_URL=
